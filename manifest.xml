<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>bfcdbf3e-b664-4722-be3d-ee13fae01b07</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>unbaiat</ProviderName>
  <DefaultLocale>ro-RO</DefaultLocale>
  <DisplayName DefaultValue="I R Coder"/>
  <Description DefaultValue="Corectează gramatical și rescrie după instrucțiuni textul selectat în Word, folosind OpenAI.">
    <Override Locale="en-US" Value="Proofread and rewrite selected text in Word with OpenAI."/>
    <Override Locale="fr-FR" Value="Corrigez et réécrivez le texte sélectionné dans Word avec OpenAI."/>
    <Override Locale="it-IT" Value="Correggi e riscrivi il testo selezionato in Word con OpenAI."/>
    <Override Locale="es-ES" Value="Corrige y reescribe el texto seleccionado en Word con OpenAI."/>
  </Description>
  <IconUrl DefaultValue="https://unbaiat.github.io/ircoder/assets/iaw-icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://unbaiat.github.io/ircoder/assets/iaw-icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/unbaiat/ircoder"/>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://unbaiat.github.io/ircoder/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://unbaiat.github.io/ircoder/assets/iaw-icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://unbaiat.github.io/ircoder/assets/iaw-icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://unbaiat.github.io/ircoder/assets/iaw-icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://unbaiat.github.io/ircoder/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="I R Coder este gata de folosit">
          <bt:Override Locale="en-US" Value="I R Coder is ready"/>
          <bt:Override Locale="fr-FR" Value="I R Coder est prêt"/>
          <bt:Override Locale="it-IT" Value="I R Coder è pronto"/>
          <bt:Override Locale="es-ES" Value="I R Coder está listo"/>
        </bt:String>
        <bt:String id="CommandsGroup.Label" DefaultValue="I R Coder"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="I R Coder"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Deschide fila Pornire și apasă butonul I R Coder pentru a corecta sau rescrie textul selectat.">
          <bt:Override Locale="en-US" Value="Go to the Home tab and select I R Coder to proofread or rewrite the selected text."/>
          <bt:Override Locale="fr-FR" Value="Ouvrez l’onglet Accueil et sélectionnez I R Coder pour corriger ou réécrire le texte sélectionné."/>
          <bt:Override Locale="it-IT" Value="Apri la scheda Home e seleziona I R Coder per correggere o riscrivere il testo selezionato."/>
          <bt:Override Locale="es-ES" Value="Ve a la pestaña Inicio y selecciona I R Coder para corregir o reescribir el texto seleccionado."/>
        </bt:String>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Deschide panoul I R Coder pentru corectură și rescriere cu OpenAI.">
          <bt:Override Locale="en-US" Value="Open I R Coder to proofread and rewrite text with OpenAI."/>
          <bt:Override Locale="fr-FR" Value="Ouvrir I R Coder pour corriger et réécrire du texte avec OpenAI."/>
          <bt:Override Locale="it-IT" Value="Apri I R Coder per correggere e riscrivere il testo con OpenAI."/>
          <bt:Override Locale="es-ES" Value="Abre I R Coder para corregir y reescribir texto con OpenAI."/>
        </bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>